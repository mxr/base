{
  "compilerOptions": {
    "declaration": true,
    "experimentalDecorators": true,
    "inlineSourceMap": true,
    "inlineSources": true,
    "lib": ["es2022"],
    "module": "nodenext",
    "noEmitOnError": true,
    "outDir": "lib",
    "resolveJsonModule": true,
    "rootDir": "src",
    "stripInternal": false,
    "target": "ES2022",
    "types": ["jest", "node"]
  },
  "exclude": ["node_modules", "src/resources"],
  "extends": "@tsconfig/strictest/tsconfig.json",
  "include": ["src/**/*.ts"]
}
