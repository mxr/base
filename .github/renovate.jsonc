// ~~ Generated by projen in mxr/base. Modifications will be overwritten on the next sync. To modify properly, edit .github/base.yml and retrigger the propagate workflow in mxr/base.
{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "commitMessageAction": "weekly",
  "commitMessagePrefix": "[renovate]",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^src/.+\\.ts$/"],
      "matchStrings": [
        "// renovate: datasource=(?<datasource>[a-zA-Z0-9-._]+?) depName=(?<depName>[^\\s]+?)(?: versioning=(?<versioning>[^\\s]+?))?(?: extractVersion=(?<extractVersion>[^\\s]+?))?\\s+(?:export )?const [A-Za-z0-9_]+ = \"(?<currentValue>[^\"]+)\""
      ]
    }
  ],
  "extends": ["config:recommended", ":disableDependencyDashboard", "customManagers:githubActionsVersions"],
  "groupSingleUpdates": true,
  "minimumReleaseAge": "7 days",
  "npmrc": "allow-remote=all",
  "packageRules": [
    {
      "commitMessageExtra": " ",
      "groupName": "update",
      "matchPackageNames": ["*"]
    },
    {
      "matchDatasources": ["github-runners"],
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    },
    {
      "enabled": false,
      "matchPackageNames": ["typescript"],
      "matchUpdateTypes": ["major"]
    },
    {
      "matchDepTypes": ["peerDependencies"],
      "rangeStrategy": "bump"
    }
  ],
  "prBodyTemplate": "{{{table}}}",
  "pre-commit": {
    "enabled": true
  },
  "schedule": ["* 19-20 * * 1"],
  "separateMajorMinor": false,
  "separateMultipleMajor": false
}
