// ~~ Generated by projen in mxr/base. Modifications will be overwritten on the next sync. To modify properly, edit .github/base.yml and retrigger the propagate workflow in mxr/base.
{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "commitMessageAction": "weekly",
  "commitMessagePrefix": "[renovate]",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.pre-commit-config\\.yaml$/"],
      "matchStrings": ["github\\.com/wasilibs/go-shellcheck/cmd/shellcheck@(?<currentValue>v[^\\s,\\]]+)"],
      "depNameTemplate": "github.com/wasilibs/go-shellcheck",
      "datasourceTemplate": "go"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^src/.+\\.ts$/"],
      "matchStrings": [
        "// renovate: datasource=(?<datasource>[a-zA-Z0-9-._]+?) depName=(?<depName>[^\\s]+?)(?: versioning=(?<versioning>[^\\s]+?))?(?: extractVersion=(?<extractVersion>[^\\s]+?))?\\s+(?:export )?const [A-Za-z0-9_]+ = \"(?<currentValue>[^\"]+)\""
      ]
    }
  ],
  "extends": ["config:recommended", ":disableDependencyDashboard", "customManagers:githubActionsVersions"],
  "groupSingleUpdates": true,
  "lockFileMaintenance": {
    "commitMessageAction": "lockfile maintenance",
    "enabled": true,
    "schedule": ["* 22-23 * * 1"]
  },
  "minimumReleaseAge": "7 days",
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "groupName": "security"
  },
  "npmrc": "allow-remote=all",
  "packageRules": [
    {
      "commitMessageExtra": " ",
      "groupName": "update",
      "matchPackageNames": ["*"]
    },
    {
      "matchDatasources": ["github-runners"],
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    },
    {
      "matchDatasources": ["deb"],
      "minimumReleaseAgeBehaviour": "timestamp-optional",
      "registryUrls": ["https://archive.ubuntu.com/ubuntu?suite=resolute&components=main&binaryArch=amd64"]
    },
    {
      "enabled": false,
      "matchPackageNames": ["typescript"],
      "matchUpdateTypes": ["major"]
    },
    {
      "matchDepTypes": ["peerDependencies"],
      "rangeStrategy": "bump"
    }
  ],
  "prBodyTemplate": "{{{table}}}",
  "schedule": ["* 21-22 * * 1"],
  "separateMajorMinor": false,
  "separateMultipleMajor": false
}
