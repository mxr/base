{
  "allowScripts": {
    "fsevents@2.3.3": true,
    "unrs-resolver@1.12.2": true
  },
  "author": {
    "email": "mxr@users.noreply.github.com",
    "name": "Max R",
    "organization": false
  },
  "bundledDependencies": [
    "yaml"
  ],
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "description": "Projen external project type for my personal repos, providing stack-appropriate pre-commit config, license, and repo metadata.",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "constructs": "10.8.1",
    "jest": "^30.4.2",
    "jest-junit": "^17",
    "jsii": "~6.0.0",
    "jsii-diff": "^1.139.0",
    "jsii-pacmak": "^1.139.0",
    "jsii-rosetta": "~6.0.0",
    "projen": "0.103.22",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "onFail": "ignore"
    }
  },
  "engines": {
    "node": "24.21.0"
  },
  "jest": {
    "clearMocks": true,
    "collectCoverage": true,
    "coverageDirectory": "coverage",
    "coveragePathIgnorePatterns": [
      "/node_modules/"
    ],
    "coverageProvider": "v8",
    "coverageReporters": [
      "json",
      "lcov",
      "clover",
      "cobertura",
      "text"
    ],
    "reporters": [
      "default",
      [
        "jest-junit",
        {
          "outputDirectory": "test-reports"
        }
      ]
    ],
    "testMatch": [
      "<rootDir>/test/**/*.test.ts"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": "test/tsconfig.json"
        }
      ]
    },
    "watchPathIgnorePatterns": [
      "/node_modules/"
    ]
  },
  "jsii": {
    "outdir": "dist",
    "targets": {},
    "tsconfig": "tsconfig.json",
    "validateTsconfig": "strict"
  },
  "keywords": [
    "projen",
    "projen-external-module"
  ],
  "license": "MIT",
  "main": "lib/index.js",
  "name": "@mxr/base",
  "overrides": {
    "glob": "^13.0.6"
  },
  "peerDependencies": {
    "constructs": "^10.8.1",
    "projen": "^0.103.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mxr/base.git"
  },
  "scripts": {
    "build": "jsii --silence-warnings=reserved-word --fail-on-warnings && cp -r src/resources lib/resources",
    "compat": "jsii-diff npm:$(node -p \"require('./package.json').name\") -k --ignore-file .compatignore || (echo \"\\nUNEXPECTED BREAKING CHANGES: add keys such as 'removed:constructs.Node.of' to .compatignore to skip.\\n\" && exit 1)",
    "package": "jsii-pacmak -v --target js",
    "prepack": "npm run build 1>&2",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "watch": "jsii -w --silence-warnings=reserved-word --fail-on-warnings"
  },
  "stability": "stable",
  "types": "lib/index.d.ts",
  "version": "0.0.55"
}
